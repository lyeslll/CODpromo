# رمز دخول لوحة /admin — ضع قيمة قوية (لا تُرفع .env إلى GitHub)
VITE_ADMIN_PIN=your-strong-pin-here

# إعدادات Supabase (من Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# مفتاح موقع hCaptcha (من dashboard.hcaptcha.com) — التجريبي ينجح دائماً
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
