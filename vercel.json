{
  "functions": {
    "api/prerender.js": {
      "includeFiles": "src/i18n/locales/**"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/offers", "destination": "/api/prerender?type=offers&lang=ar" },
    { "source": "/en/offers", "destination": "/api/prerender?type=offers&lang=en" },
    { "source": "/fr/offers", "destination": "/api/prerender?type=offers&lang=fr" },
    { "source": "/partners", "destination": "/api/prerender?type=partners&lang=ar" },
    { "source": "/en/partners", "destination": "/api/prerender?type=partners&lang=en" },
    { "source": "/fr/partners", "destination": "/api/prerender?type=partners&lang=fr" },
    { "source": "/store/:slug", "destination": "/api/prerender?type=store&lang=ar&slug=:slug" },
    { "source": "/en/store/:slug", "destination": "/api/prerender?type=store&lang=en&slug=:slug" },
    { "source": "/fr/store/:slug", "destination": "/api/prerender?type=store&lang=fr&slug=:slug" },
    { "source": "/category/:slug", "destination": "/api/prerender?type=category&lang=ar&slug=:slug" },
    { "source": "/en/category/:slug", "destination": "/api/prerender?type=category&lang=en&slug=:slug" },
    { "source": "/fr/category/:slug", "destination": "/api/prerender?type=category&lang=fr&slug=:slug" },
    { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
